function webform_ticket_pdf_preprocess_menu(array &$variables) {
  $current_user = \Drupal::currentUser();

  if ($current_user->isAnonymous()) {
    return;
  }

  $webform_id = \Drupal::service('domain_settings.manager')
    ->getTicketWebformId();

  if (!$webform_id) {
    return;
  }

  $has_submission = webform_ticket_pdf_user_has_submission(
    $webform_id,
    $current_user->id()
  );

  foreach ($variables['items'] as &$item) {
    if (empty($item['url'])) {
      continue;
    }

    if ($item['url']->toString() === '/my-registration') {
      $item['title'] = $has_submission
        ? t('My registration')
        : t('Registration');
    }
  }
}

/**
 * Checks whether a user already has a submission for a webform.
 */
function webform_ticket_pdf_user_has_submission(string $webform_id, int $uid): bool {
  $storage = \Drupal::entityTypeManager()
    ->getStorage('webform_submission');

  $ids = $storage->getQuery()
    ->condition('webform_id', $webform_id)
    ->condition('uid', $uid)
    ->range(0, 1)
    ->accessCheck(FALSE)
    ->execute();

  return !empty($ids);
}


/**
 * Implements hook_form_alter().
 */
function webform_ticket_pdf_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  if (!str_contains($form_id, 'webform')) {
    return;
  }

  $build_info = $form_state->getBuildInfo();

  if (empty($build_info['callback_object'])) {
    return;
  }

  $callback_object = $build_info['callback_object'];

  if (!method_exists($callback_object, 'getEntity')) {
    return;
  }

  $entity = $callback_object->getEntity();

  if (!$entity instanceof WebformSubmissionInterface) {
    return;
  }

  $configured_webform_id = \Drupal::service('domain_settings.manager')
    ->getTicketWebformId();

  if (!$configured_webform_id) {
    return;
  }

  if ($entity->getWebform()->id() !== $configured_webform_id) {
    return;
  }

  $form['ticket_actions'] = [
    '#type' => 'container',
    '#attributes' => [
      'class' => ['ticket-actions'],
    ],
    '#weight' => -100,
  ];

  $form['ticket_actions']['download_ticket'] = [
    '#type' => 'link',
    '#title' => t('Download ticket'),
    '#url' => Url::fromRoute('webform_ticket_pdf.download_ticket', [
      'webform' => $entity->getWebform()->id(),
      'webform_submission' => $entity->id(),
    ]),
    '#attributes' => [
      'class' => ['button', 'button--primary'],
      'target' => '_blank',
    ],
  ];

  $form['ticket_actions']['email_ticket'] = [
    '#type' => 'link',
    '#title' => t('Email ticket'),
    '#url' => Url::fromRoute('webform_ticket_pdf.email_ticket', [
      'webform' => $entity->getWebform()->id(),
      'webform_submission' => $entity->id(),
    ]),
    '#attributes' => [
      'class' => ['button'],
    ],
  ];
}

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * Adds ticket buttons to the Webform submissions overview table.
 */
function webform_ticket_pdf_form_webform_results_submissions_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $webform = $form_state->get('webform');

  if (!$webform) {
    return;
  }

  $configured_webform_id = \Drupal::service('domain_settings.manager')
    ->getTicketWebformId();

  if (!$configured_webform_id || $webform->id() !== $configured_webform_id) {
    return;
  }

  if (empty($form['submissions']['#header']) || empty($form['submissions']['#options'])) {
    return;
  }

  $form['submissions']['#header']['ticket_actions'] = t('Ticket');

  foreach ($form['submissions']['#options'] as $sid => &$row) {
    if (!is_numeric($sid)) {
      continue;
    }

    $row['ticket_actions'] = [
      'data' => [
        '#type' => 'container',
        '#attributes' => [
          'class' => ['ticket-actions'],
        ],
        'download' => [
          '#type' => 'link',
          '#title' => t('Download'),
          '#url' => Url::fromRoute('webform_ticket_pdf.download_ticket', [
            'webform' => $configured_webform_id,
            'webform_submission' => $sid,
          ]),
          '#attributes' => [
            'class' => ['button', 'button--small'],
            'target' => '_blank',
          ],
        ],
        'email' => [
          '#type' => 'link',
          '#title' => t('Email'),
          '#url' => Url::fromRoute('webform_ticket_pdf.email_ticket', [
            'webform' => $configured_webform_id,
            'webform_submission' => $sid,
          ]),
          '#attributes' => [
            'class' => ['button', 'button--small'],
          ],
        ],
      ],
    ];
  }
}
