/**
 * Implements hook_form_alter().
 */
function webform_ticket_pdf_form_webform_submission_fm_day_2026_bulk_add_form_alter(
  array &$form,
  FormStateInterface $form_state,
  $form_id
) {
  \Drupal::logger('webform_ticket_pdf')->notice('Altering form: ' . $form_id);
  _webform_ticket_pdf_prefill_company_name($form, $form_state);
}




function _webform_ticket_pdf_prefill_company_name(array &$form, FormStateInterface $form_state) {
  // Only continue if the company name element exists on the current page.
  if (empty($form['elements']['company_name'])) {
    return;
  }

  // Get the current webform submission being filled in.
  $webform_submission = $form_state->getFormObject()->getEntity();

  if (!$webform_submission) {
    return;
  }

  // Get data already entered on previous pages.
  $data = $webform_submission->getData();

  if (empty($data['email'])) {
    return;
  }

  $email = trim(strtolower($data['email']));

  if (!$email) {
    return;
  }

  // Do not overwrite if the user already entered a company name.
  if (!empty($data['company_name'])) {
    return;
  }

  $company_name = _mymodule_find_company_name_by_email($email);

  if (!$company_name) {
    return;
  }

  // Set the default value on the second page field.
  $form['elements']['company_name']['#default_value'] = $company_name;

  // Also set it in the submission data.
  $data['company_name'] = $company_name;
  $webform_submission->setData($data);
}

