<?php
use Drupal\Core\Url;
use Drupal\webform\WebformSubmissionInterface;

/**
 * Returns enabled webform ids.
 */
function webform_ticket_pdf_enabled_webforms(): array {
  return [
    'aquarama_trade_fair_2025',
    'another_event_webform',
  ];
}

/**
 * Implements hook_webform_submission_insert().
 */
function webform_ticket_pdf_webform_submission_insert(
  WebformSubmissionInterface $submission
) {

  // Your webform machine name.
  // if ($submission->getWebform()->id() !== 'aquarama_trade_fair_2025') {
  //   return;
  // }
  // $webform_id = $submission->getWebform()->id();

  // if (!in_array($webform_id, webform_ticket_pdf_enabled_webforms(), TRUE)) {
  //   return;
  // }

  $configured_webform_id = \Drupal::service('domain_settings.manager')
    ->getTicketWebformId();

  if (!$configured_webform_id) {
    return;
  }

  if ($submission->getWebform()->id() !== $configured_webform_id) {
    return;
  }

  $generator = \Drupal::service(
    'webform_ticket_pdf.generator'
  );

  $pdf_uri = $generator->generate($submission);

  // Store PDF path in submission data.
  $data = $submission->getData();

  $data['ticket_pdf'] = $pdf_uri;

  $submission->setData($data);

  $submission->save();
}

/**
 * Implements hook_webform_submission_update().
 */
function webform_ticket_pdf_webform_submission_update(
  WebformSubmissionInterface $submission
) {
  // if ($submission->getWebform()->id() !== 'aquarama_trade_fair_2025') {
  //   return;
  // }
  // $webform_id = $submission->getWebform()->id();

  // if (!in_array($webform_id, webform_ticket_pdf_enabled_webforms(), TRUE)) {
  //   return;
  // }
  $configured_webform_id = \Drupal::service('domain_settings.manager')
    ->getTicketWebformId();

  if (!$configured_webform_id) {
    return;
  }

  if ($submission->getWebform()->id() !== $configured_webform_id) {
    return;
  }

  $generator = \Drupal::service('webform_ticket_pdf.generator');

  $pdf_uri = $generator->generate($submission);
\Drupal::logger('webform_ticket_pdf')->notice('Generated ticket PDF for submission: ' . $submission->id() . ', PDF URI: ' . $pdf_uri);

  $data = $submission->getData();
  $data['ticket_pdf'] = $pdf_uri;

  $submission->setData($data);

  // Avoid infinite loop by not saving again here.
}

/**
 * Implements hook_entity_view().
 */
function webform_ticket_pdf_entity_view(array &$build, \Drupal\Core\Entity\EntityInterface $entity, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display, $view_mode) {
  if (!$entity instanceof WebformSubmissionInterface) {
    return;
  }

  // if ($entity->getWebform()->id() !== 'aquarama_trade_fair_2025') {
  //   return;
  // }

  $webform_id = $entity->getWebform()->id();

  if (!in_array($webform_id, webform_ticket_pdf_enabled_webforms(), TRUE)) {
    return;
  }

  $data = $entity->getData();

  if (empty($data['ticket_pdf'])) {
    return;
  }

  $url = Url::fromRoute('webform_ticket_pdf.download_ticket', [
    'webform' => $entity->getWebform()->id(),
    'webform_submission' => $entity->id(),
  ]);

  $build['ticket_pdf_button'] = [
    '#type' => 'link',
    '#title' => t('Open entrance ticket'),
    '#url' => $url,
    '#attributes' => [
      'class' => ['button', 'button--primary'],
      'target' => '_blank',
    ],
    '#weight' => -10,
  ];
}


