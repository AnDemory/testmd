function webform_ticket_pdf_preprocess_menu(array &$variables) {
  $current_user = \Drupal::currentUser();

  if ($current_user->isAnonymous()) {
    return;
  }

  $webform_id = \Drupal::service('domain_settings.manager')
    ->getTicketWebformId();

  if (!$webform_id) {
    return;
  }

  $has_submission = webform_ticket_pdf_user_has_submission(
    $webform_id,
    $current_user->id()
  );

  foreach ($variables['items'] as &$item) {
    if (empty($item['url'])) {
      continue;
    }

    if ($item['url']->toString() === '/my-registration') {
      $item['title'] = $has_submission
        ? t('My registration')
        : t('Registration');
    }
  }
}

/**
 * Checks whether a user already has a submission for a webform.
 */
function webform_ticket_pdf_user_has_submission(string $webform_id, int $uid): bool {
  $storage = \Drupal::entityTypeManager()
    ->getStorage('webform_submission');

  $ids = $storage->getQuery()
    ->condition('webform_id', $webform_id)
    ->condition('uid', $uid)
    ->range(0, 1)
    ->accessCheck(FALSE)
    ->execute();

  return !empty($ids);
}


