<?php

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\webform\Entity\WebformSubmission;
use Drupal\webform\WebformSubmissionInterface;
use Drupal\user\UserInterface;
use Drupal\webform\Entity\Webform;
use Drupal\Core\Entity\EntityInterface;


/**
 * Implements hook_form_alter().
 * Bulk visitor registration: fill company name field on page 2 based on email address entered on page 1.
 */
function webform_ticket_pdf_form_alter(
  array &$form,
  FormStateInterface $form_state,
  $form_id
) {
  $form_object = $form_state->getFormObject();

  if (!method_exists($form_object, 'getEntity')) {
    return;
  }

  $entity = $form_object->getEntity();

  if (!$entity instanceof \Drupal\webform\WebformSubmissionInterface) {
    return;
  }

  $webform = $entity->getWebform();

  if (!$webform) {
    return;
  }

  $categories = (array) $webform->get('categories');

  if (!in_array('bulk', $categories, TRUE)) {
    return;
  }

  _webform_ticket_pdf_prefill_company_name($form, $form_state);
}


function _webform_ticket_pdf_prefill_company_name(array &$form, FormStateInterface $form_state) {

  if (empty($form['elements']['persoonlijke_gegevens']['company_name'])) {
    return;
  }

  // Get the current webform submission being filled in.
  $webform_submission = $form_state->getFormObject()->getEntity();
  if (!$webform_submission) {
    return;
  }

  // Get data already entered on previous pages.
  $data = $webform_submission->getData();
  if (empty($data['e_mail'])) {
    return;
  }

  $email = trim(strtolower($data['e_mail']));
  if (!$email) {
    return;
  }

  // Do not overwrite if the user already entered a company name.
  if (!empty($data['company_name'])) {
    return;
  }

  $company_name = webform_ticket_pdf_find_company_name_by_email($email);
  if (!$company_name) {
    return;
  }

  // Set the default value on the second page field.
  $form['elements']['persoonlijke_gegevens']['company_name']['#default_value'] = $company_name;
  $form['elements']['persoonlijke_gegevens']['company_name']['#attributes']['readonly'] = 'readonly';

  // Also set it in the submission data.
  $data['company_name'] = $company_name;
  $webform_submission->setData($data);
}

function webform_ticket_pdf_find_company_name_by_email(string $email): ?string {
  $users = \Drupal::entityTypeManager()
    ->getStorage('user')
    ->loadByProperties([
      'mail' => $email,
    ]);

  if (!$users) {
    \Drupal::logger('webform_ticket_pdf')->notice('No user found with email: ' . $email);
    return NULL;
  }

  /** @var \Drupal\user\UserInterface $user */
  $user = reset($users);

  if (!$user->hasField('field_company_name')) {
   return NULL;
  }

  if ($user->get('field_company_name')->isEmpty()) {
    return NULL;
  }

  return $user->get('field_company_name')->value;
}

/**
 * Implements hook_webform_submission_insert().
 * Use only for physical PDF generation on submission, which is now deprecated in favor of on-demand generation in TicketDownloadController.
 */
function webform_ticket_pdf_webform_submission_insert(
  WebformSubmissionInterface $submission
) {

  $current_user = \Drupal::currentUser();

  if ($current_user->isAnonymous()) {
    $request = \Drupal::request();

    if ($request->hasSession()) {
      $session = $request->getSession();

      $submission_ids = $session->get(
        'webform_ticket_pdf.submissions',
        []
      );

      $submission_ids[(string) $submission->id()] = TRUE;

      $session->set(
        'webform_ticket_pdf.submissions',
        $submission_ids
      );
    }
  }

}

/**
 * Implements hook_webform_submission_update().
 * Use only for physical PDF generation on submission, which is now deprecated in favor of on-demand generation in TicketDownloadController.
 */
function webform_ticket_pdf_webform_submission_update(
  WebformSubmissionInterface $submission
) {
}


/**
 * Implements hook_preprocess_menu().
 * Updates the "My registration" menu item title if the user already has a submission, to avoid confusion about whether they can submit again.
 */
function webform_ticket_pdf_preprocess_menu(array &$variables) {
  $current_user = \Drupal::currentUser();

  if ($current_user->isAnonymous()) {
    return;
  }

  $webform_id = \Drupal::service('domain_settings.manager')
    ->getTicketWebformId();

  if (!$webform_id) {
    return;
  }

  $has_submission = webform_ticket_pdf_user_has_submission(
    $webform_id,
    $current_user->id()
  );

  foreach ($variables['items'] as &$item) {
    if (empty($item['url'])) {
      continue;
    }

    if ($item['url']->toString() === '/my-registration') {
      $item['title'] = $has_submission
        ? t('My registration')
        : t('Registration');
    }
  }
}

/**
 * Checks whether a user already has a submission for a webform.
 */
function webform_ticket_pdf_user_has_submission(string $webform_id, int $uid): bool {
  $storage = \Drupal::entityTypeManager()
    ->getStorage('webform_submission');

  $ids = $storage->getQuery()
    ->condition('webform_id', $webform_id)
    ->condition('uid', $uid)
    ->range(0, 1)
    ->accessCheck(FALSE)
    ->execute();

  return !empty($ids);
}


/**
 * Gets the domain ID linked to a ticket submission.
 */
function webform_ticket_pdf_get_domain_for_submission(WebformSubmissionInterface $submission): ?string {
  $webform_id = $submission->getWebform()->id();

  $ticket_webform_ids_by_domain = \Drupal::service('domain_settings.manager')
    ->getAllTicketWebformIdsByDomain();

  $domain = FALSE;

  foreach ($ticket_webform_ids_by_domain as $domain_name => $webform_ids) {
    if (in_array($webform_id, $webform_ids, TRUE)) {
      $domain = $domain_name;
      break;
    }
  }

  if ($domain !== FALSE) {
    return $domain;
  }

  $ticket_exhibitor_webform_ids_by_domain = \Drupal::service('domain_settings.manager')
    ->getTicketExhibitorWebformIdsByDomain();


  foreach ($ticket_exhibitor_webform_ids_by_domain as $domain_name => $webform_ids) {
    if (in_array($webform_id, $webform_ids, TRUE)) {
      $domain = $domain_name;
      break;
    }
  }

  if ($domain !== FALSE) {
    return $domain;
  }

  $ticket_visitor_bulk_webform_ids_by_domain = \Drupal::service('domain_settings.manager')
    ->getTicketVisitorBulkWebformIdsByDomain();


  foreach ($ticket_visitor_bulk_webform_ids_by_domain as $domain_name => $webform_ids) {
    if (in_array($webform_id, $webform_ids, TRUE)) {
      $domain = $domain_name;
      break;
    }
  }

  return $domain !== FALSE ? $domain : NULL;
}


/**
 * Checks whether this is a configured ticket submission.
 */
function webform_ticket_pdf_is_ticket_submission(WebformSubmissionInterface $submission): bool {
  return webform_ticket_pdf_get_domain_for_submission($submission) !== NULL;
}


/**
 * Checks whether this is a visitor or exhibitor category webform
 */
function webform_ticket_pdf_type(string $webform_id): string {
  $webform = Webform::load($webform_id);

  if ($webform) {
    $categories = (array) $webform->get('categories');
    $type_categories = ['visitor', 'exhibitor'];
    $matched = array_intersect($type_categories, $categories);
    $type = '';

    if ($matched) {
      $type = reset($matched); // visitor or exhibitor
    }
    return $type;
  }
}

function webform_ticket_pdf_is_bulk(string $webform_id): bool {
  $webform = Webform::load($webform_id);

  if ($webform) {
    $categories = (array) $webform->get('categories');
    $type_categories = ['bulk'];
    $matched = array_intersect($type_categories, $categories);
    $is_bulk = false;

    if ($matched) {
      $is_bulk = true;
    }
    return $is_bulk;
  }
}


/**
 * Implements hook_link_alter().
 */
function webform_ticket_pdf_link_alter(&$variables) {
  if (empty($variables['url'])) {
    return;
  }

  /** @var \Drupal\Core\Url $url */
  $url = $variables['url'];

  if (!$url->isRouted()) {
    return;
  }

  $new_tab_routes = [
    'webform_ticket_pdf.download_ticket',
    'webform_ticket_pdf.print_ticket',
  ];

  if (!in_array($url->getRouteName(), $new_tab_routes, TRUE)) {
    return;
  }

  $variables['options']['attributes']['target'] = '_blank';
  $variables['options']['attributes']['rel'] = 'noopener noreferrer';
}

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * Adds ticket actions to each row on the Webform submissions overview page.
 */
function webform_ticket_pdf_form_webform_submission_bulk_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  \Drupal::logger('webform_ticket_pdf')->notice('<pre>@items</pre>', [
    '@items' => print_r(array_keys($form['items']), TRUE),
  ]);


  $options = $form['items']['#options'] ?? [];

  \Drupal::logger('webform_ticket_pdf')->notice('Option keys: @keys', [
    '@keys' => implode(', ', array_slice(array_keys($options), 0, 10)),
  ]);

  $first_key = array_key_first($options);
  if ($first_key !== NULL) {
    \Drupal::logger('webform_ticket_pdf')->notice('First option key: @key; columns: @columns', [
      '@key' => $first_key,
      '@columns' => implode(', ', array_keys($options[$first_key])),
    ]);
  }

  $route_match = \Drupal::routeMatch();

  $webform = $route_match->getParameter('webform');

  if (!$webform || !method_exists($webform, 'id')) {
    return;
  }

  $webform_id = $webform->id();

  $ticket_webform_ids = \Drupal::service('domain_settings.manager')
  ->getAllTicketWebformIdsByDomain();

  $flat_ids = array_merge(...array_values($ticket_webform_ids));

  if (!in_array($webform->id(), $flat_ids, TRUE)) {
    return;
  }

  if (!isset($form['items']['#options'])) {
    return;
  }

  // Add a new column header.
  $form['items']['#header'] = ['ticket_actions' => t('Ticket'),] + $form['items']['#header'];

  $current_path = \Drupal::service('path.current')->getPath();

  foreach ($form['items']['#options'] as $sid => &$row) {
    if (!is_numeric($sid)) {
      continue;
    }

    $row['ticket_actions'] = [
      'data' => [
        '#type' => 'container',
        '#attributes' => [
          'class' => ['ticket-actions'],
        ],

        'view' => [
          '#type' => 'link',
          '#title' => t('View'),
          '#url' => Url::fromRoute('webform_ticket_pdf.download_ticket', [
            'webform' => $webform_id,
            'webform_submission' => $sid,
          ]),
          '#attributes' => [
            'class' => ['button', 'button--small'],
            'target' => '_blank',
            'rel' => 'noopener noreferrer',
          ],
        ],

        'print' => [
          '#type' => 'link',
          '#title' => t('Print'),
          '#url' => Url::fromRoute('webform_ticket_pdf.print_ticket', [
            'webform' => $webform_id,
            'webform_submission' => $sid,
          ]),
          '#attributes' => [
            'class' => ['button', 'button--small'],
            'target' => '_blank',
            'rel' => 'noopener noreferrer',
          ],
        ],

        'email' => [
          '#type' => 'link',
          '#title' => t('Email'),
          '#url' => Url::fromRoute('webform_ticket_pdf.email_ticket', [
            'webform' => $webform_id,
            'webform_submission' => $sid,
          ], [
            'query' => [
              'destination' => $current_path,
            ],
          ]),
          '#attributes' => [
            'class' => ['button', 'button--small'],
          ],
        ],
      ],
    ];
  }

  $form['actions']['add_submission'] = [
    '#type' => 'link',
    '#title' => t('Add submission'),
    '#url' => Url::fromRoute('entity.webform.canonical', [
      'webform' => $webform->id(),
    ]),
    '#attributes' => [
      'class' => ['button', 'button--primary'],
      'target' => '_blank',
    ],
  ];

  $webform_type = webform_ticket_pdf_type($webform_id);
  if ($webform_type === 'visitor' && !webform_ticket_pdf_is_bulk($webform_id)) {
    _webform_ticket_pdf_add_user_columns_to_submissions_table($form);
  }

}

/**
 * Adds user columns to the Webform submissions overview table.
 */
function _webform_ticket_pdf_add_user_columns_to_submissions_table(array &$form): void {
  if (empty($form['items']['#header']) || empty($form['items']['#rows'])) {
    return;
  }

  // Add headers.
  $form['items']['#header'] = ['ticket_actions' => t('Ticket'),] + $form['items']['#header'];
  $form['items']['#header'] = ['first_name' => t('First name'),] + $form['items']['#header'];
  $form['items']['#header'] = ['last_name' => t('Name'),] + $form['items']['#header'];
  $form['items']['#header'] = ['company' =>  t('Company'),] + $form['items']['#header'];
  $options = &$form['items']['#options'];
  $storage = \Drupal::entityTypeManager()->getStorage('webform_submission');

  foreach ($options as $key => &$row) {
    $sid = NULL;

    // Case 1: the row key is the submission ID.
    if (is_numeric($key)) {
      $sid = $key;
    }

    // Case 2: sid/id is stored in the row.
    if (!$sid && !empty($row['sid'])) {
      $sid = is_array($row['sid']) && isset($row['sid']['#markup'])
        ? $row['sid']['#markup']
        : $row['sid'];
    }

    if (!$sid && !empty($row['id'])) {
      $sid = is_array($row['id']) && isset($row['id']['#markup'])
        ? $row['id']['#markup']
        : $row['id'];
    }

    if (!$sid || !is_numeric($sid)) {
      $row['first_name'] = '';
      $row['last_name'] = '';
      $row['company'] = '';
      continue;
    }

    $submission = $storage->load($sid);

    if (!$submission instanceof \Drupal\webform\WebformSubmissionInterface) {
      $row['first_name'] = '';
      $row['last_name'] = '';
      $row['company'] = '';
      continue;
    }

    $owner = $submission->getOwner();

    if (!$owner instanceof \Drupal\user\UserInterface || $owner->isAnonymous()) {
      $row['first_name'] = '';
      $row['last_name'] = '';
      $row['company'] = '';
      continue;
    }

    $row['first_name'] = _webform_ticket_pdf_user_field_value($owner, 'field_first_name');
    $row['last_name'] = _webform_ticket_pdf_user_field_value($owner, 'field_name');
    $row['company'] = _webform_ticket_pdf_user_field_value($owner, 'field_company_name');
  }
}

/**
 * Safely gets a user field value.
 */
function _webform_ticket_pdf_user_field_value(UserInterface $user, string $field_name): string {
  if (!$user->hasField($field_name) || $user->get($field_name)->isEmpty()) {
    return '';
  }

  $field = $user->get($field_name);

  if (!empty($field->entity) && $field->entity instanceof EntityInterface) {
    return $field->entity->label();
  }

  return (string) $field->value;
}
