/**
 * Implements hook_form_FORM_ID_alter().
 *
 * Adds ticket actions to each row on the Webform submissions overview page.
 */
function webform_ticket_pdf_form_webform_submission_bulk_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $route_match = \Drupal::routeMatch();

  $webform = $route_match->getParameter('webform');

  if (!$webform || !method_exists($webform, 'id')) {
    return;
  }

  $ticket_webform_ids = \Drupal::service('domain_settings.manager')
  ->getTicketWebformIdsByDomain();

  if (!in_array($webform->id(), $ticket_webform_ids, TRUE)) {
    return;
  }

  if (!isset($form['items']['#options'])) {
    return;
  }

  // Add a new column header.
  $form['items']['#header'] = ['ticket_actions' => t('Ticket'),] + $form['items']['#header'];

  $current_path = \Drupal::service('path.current')->getPath();

  foreach ($form['items']['#options'] as $sid => &$row) {
    if (!is_numeric($sid)) {
      continue;
    }

    $row['ticket_actions'] = [
      'data' => [
        '#type' => 'container',
        '#attributes' => [
          'class' => ['ticket-actions'],
        ],

        'view' => [
          '#type' => 'link',
          '#title' => t('View'),
          '#url' => Url::fromRoute('webform_ticket_pdf.download_ticket', [
            'webform' => $webform->id(),
            'webform_submission' => $sid,
          ]),
          '#attributes' => [
            'class' => ['button', 'button--small'],
            'target' => '_blank',
            'rel' => 'noopener noreferrer',
          ],
        ],

        'print' => [
          '#type' => 'link',
          '#title' => t('Print'),
          '#url' => Url::fromRoute('webform_ticket_pdf.print_ticket', [
            'webform' => $webform->id(),
            'webform_submission' => $sid,
          ]),
          '#attributes' => [
            'class' => ['button', 'button--small'],
            'target' => '_blank',
            'rel' => 'noopener noreferrer',
          ],
        ],

        'email' => [
          '#type' => 'link',
          '#title' => t('Email'),
          '#url' => Url::fromRoute('webform_ticket_pdf.email_ticket', [
            'webform' => $webform->id(),
            'webform_submission' => $sid,
          ], [
            'query' => [
              'destination' => $current_path,
            ],
          ]),
          '#attributes' => [
            'class' => ['button', 'button--small'],
          ],
        ],
      ],
    ];
  }
}
