/**
 * Implements hook_preprocess_menu().
 * Updates the "My registration" menu item title if the user already has a submission, to avoid confusion about whether they can submit again.
 */
function webform_ticket_pdf_preprocess_menu(array &$variables) {
  $current_user = \Drupal::currentUser();

  if ($current_user->isAnonymous()) {
    return;
  }

  $webform_id = \Drupal::service('domain_settings.manager')
    ->getTicketWebformId();

  if (!$webform_id) {
    return;
  }

  $has_submission = webform_ticket_pdf_user_has_submission(
    $webform_id,
    $current_user->id()
  );

  foreach ($variables['items'] as &$item) {
    if (empty($item['url'])) {
      continue;
    }

    if ($item['url']->toString() === '/my-registration') {
      $item['title'] = $has_submission
        ? t('My registration')
        : t('Registration');
    }
  }
}

/**
 * Checks whether a user already has a submission for a webform.
 */
function webform_ticket_pdf_user_has_submission(string $webform_id, int $uid): bool {
  $storage = \Drupal::entityTypeManager()
    ->getStorage('webform_submission');

  $ids = $storage->getQuery()
    ->condition('webform_id', $webform_id)
    ->condition('uid', $uid)
    ->range(0, 1)
    ->accessCheck(FALSE)
    ->execute();

  return !empty($ids);
}


/**
 * Gets the domain ID linked to a ticket submission.
 */
function webform_ticket_pdf_get_domain_for_submission(WebformSubmissionInterface $submission): ?string {
  $webform_id = $submission->getWebform()->id();

  $ticket_webform_ids_by_domain = \Drupal::service('domain_settings.manager')
    ->getAllTicketWebformIdsByDomain();

  $domain = array_search($webform_id, $ticket_webform_ids_by_domain, TRUE);
  if ($domain !== FALSE) {
    return $domain;
  }

  $ticket_exhibitor_webform_ids_by_domain = \Drupal::service('domain_settings.manager')
    ->getTicketExhibitorWebformIdsByDomain();

  $domain = array_search($webform_id, $ticket_exhibitor_webform_ids_by_domain, TRUE);

  return $domain !== FALSE ? $domain : NULL;
}


/**
 * Checks whether this is a configured ticket submission.
 */
function webform_ticket_pdf_is_ticket_submission(WebformSubmissionInterface $submission): bool {
  return webform_ticket_pdf_get_domain_for_submission($submission) !== NULL;
}


/**
 * Checks whether this is a visitor or exhibitor category webform
 */
function webform_ticket_pdf_type(string $webform_id): string {
  $webform = Webform::load($webform_id);

  if ($webform) {
    $categories = (array) $webform->get('categories');
    $type_categories = ['visitor', 'exhibitor'];
    $matched = array_intersect($type_categories, $categories);
    $type = NULL;

    if ($matched) {
      $type = reset($matched); // visitor or exhibitor
    }
    return $type;
  }
}


/**
 * Implements hook_link_alter().
 */
function webform_ticket_pdf_link_alter(&$variables) {
  if (empty($variables['url'])) {
    return;
  }

  /** @var \Drupal\Core\Url $url */
  $url = $variables['url'];

  if (!$url->isRouted()) {
    return;
  }

  $new_tab_routes = [
    'webform_ticket_pdf.download_ticket',
    'webform_ticket_pdf.print_ticket',
  ];

  if (!in_array($url->getRouteName(), $new_tab_routes, TRUE)) {
    return;
  }

  $variables['options']['attributes']['target'] = '_blank';
  $variables['options']['attributes']['rel'] = 'noopener noreferrer';
}


