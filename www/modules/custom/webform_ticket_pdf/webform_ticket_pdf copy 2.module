/**
 * Implements hook_form_alter().
 */
function webform_ticket_pdf_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  if (!str_contains($form_id, 'webform')) {
    return;
  }

  $keys = implode(', ', array_keys($form));
  $build_info = $form_state->getBuildInfo();
  $callback_class = !empty($build_info['callback_object'])
    ? get_class($build_info['callback_object'])
    : 'none';

  \Drupal::logger('webform_ticket_pdf')->notice(
    'FORM ID: @form_id | callback: @callback | keys: @keys',
    [
      '@form_id' => $form_id,
      '@callback' => $callback_class,
      '@keys' => $keys,
    ]
  );
}

