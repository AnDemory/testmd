/**
 * Implements hook_preprocess_table().
 */
function webform_ticket_pdf_preprocess_table(array &$variables) {
  $route_match = \Drupal::routeMatch();

  $webform = $route_match->getParameter('webform');

  if (!$webform || !method_exists($webform, 'id')) {
    return;
  }

  $configured_webform_id = \Drupal::service('domain_settings.manager')
    ->getTicketWebformId();

  if (!$configured_webform_id || $webform->id() !== $configured_webform_id) {
    return;
  }

  if (empty($variables['rows'])) {
    return;
  }

  // Only target tables that look like a Webform submissions overview table.
  $has_sid_column = FALSE;

  foreach ($variables['header'] as $header_cell) {
    $header_text = is_array($header_cell) && isset($header_cell['data'])
      ? (string) $header_cell['data']
      : (string) $header_cell;

    if (stripos($header_text, 'sid') !== FALSE || stripos($header_text, 'serial') !== FALSE || stripos($header_text, '#') !== FALSE) {
      $has_sid_column = TRUE;
      break;
    }
  }

  if (!$has_sid_column) {
    return;
  }

  $variables['header'][] = t('Ticket');

  foreach ($variables['rows'] as &$row) {
    if (empty($row['cells'])) {
      continue;
    }

    $sid = NULL;

    foreach ($row['cells'] as $cell) {
      $cell_content = is_array($cell) && isset($cell['content'])
        ? $cell['content']
        : $cell;

      $rendered = is_array($cell_content)
        ? \Drupal::service('renderer')->renderPlain($cell_content)
        : (string) $cell_content;

      if (preg_match('/\/submission\/(\d+)/', $rendered, $matches)) {
        $sid = $matches[1];
        break;
      }

      if (preg_match('/\b(\d+)\b/', trim(strip_tags($rendered)), $matches)) {
        $sid = $matches[1];
        break;
      }
    }

    if (!$sid) {
      $row['cells'][] = '';
      continue;
    }

    $row['cells'][] = [
      'content' => [
        '#type' => 'container',
        '#attributes' => [
          'class' => ['ticket-actions'],
        ],
        'download' => [
          '#type' => 'link',
          '#title' => t('Download'),
          '#url' => Url::fromRoute('webform_ticket_pdf.download_ticket', [
            'webform' => $configured_webform_id,
            'webform_submission' => $sid,
          ]),
          '#attributes' => [
            'class' => ['button', 'button--small'],
            'target' => '_blank',
          ],
        ],
        'email' => [
          '#type' => 'link',
          '#title' => t('Email'),
          '#url' => Url::fromRoute('webform_ticket_pdf.email_ticket', [
            'webform' => $configured_webform_id,
            'webform_submission' => $sid,
          ]),
          '#attributes' => [
            'class' => ['button', 'button--small'],
          ],
        ],
      ],
    ];
  }
}
