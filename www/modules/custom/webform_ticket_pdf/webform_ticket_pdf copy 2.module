/**
 * Implements hook_form_FORM_ID_alter().
 *
 * Adds ticket buttons to the Webform submissions overview bulk table.
 */
function webform_ticket_pdf_form_webform_submission_bulk_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $route_match = \Drupal::routeMatch();

  $webform = $route_match->getParameter('webform');

  if (!$webform || !method_exists($webform, 'id')) {
    return;
  }

  $configured_webform_id = \Drupal::service('domain_settings.manager')
    ->getTicketWebformId();

  if (!$configured_webform_id || $webform->id() !== $configured_webform_id) {
    return;
  }

  if (empty($form['items'])) {
    return;
  }

  \Drupal::logger('webform_ticket_pdf')->notice('Bulk form item keys: @keys', [
  '@keys' => implode(', ', array_keys($form['items'])),
]);

  // Add a new table header column.
  if (!empty($form['items']['#header'])) {
    $form['items']['#header']['ticket_actions'] = t('Ticket');
  }

  // Add Download / Email links to each submission row.
  foreach ($form['items'] as $sid => &$row) {
    if (!is_numeric($sid)) {
      continue;
    }

    $row['ticket_actions'] = [
      '#type' => 'container',
      '#attributes' => [
        'class' => ['ticket-actions'],
      ],
      'download' => [
        '#type' => 'link',
        '#title' => t('Download'),
        '#url' => Url::fromRoute('webform_ticket_pdf.download_ticket', [
          'webform' => $configured_webform_id,
          'webform_submission' => $sid,
        ]),
        '#attributes' => [
          'class' => ['button', 'button--small'],
          'target' => '_blank',
        ],
      ],
      'email' => [
        '#type' => 'link',
        '#title' => t('Email'),
        '#url' => Url::fromRoute('webform_ticket_pdf.email_ticket', [
          'webform' => $configured_webform_id,
          'webform_submission' => $sid,
        ]),
        '#attributes' => [
          'class' => ['button', 'button--small'],
        ],
      ],
    ];
  }
}

